    },
    {
      "ms": 390.30000019073486,
      "type": "request-start",
      "request": 6,
      "text": "Oh!",
      "emotion": "surprised",
      "origin": "playback"
    },
    {
      "ms": 390.5,
      "type": "request-start",
      "request": 7,
      "text": "What was that?",
      "emotion": "scared",
