    },
    {
      "ms": 389.5,
      "type": "request-start",
      "request": 2,
      "text": "Let me show you what this rig can do.",
      "emotion": "joy",
      "origin": "playback"
    },
    {
      "ms": 389.69999980926514,
      "type": "request-start",
      "request": 3,
      "text": "When I'm excited, everything lifts, and I just can't help spinning around!",
      "emotion": "excited",
      "origin": "playback"
    },
    {
      "ms": 389.69999980926514,
      "type": "request-start",
      "request": 4,
      "text": "When I'm sad, it all sinks down.",
      "emotion": "sad",
      "origin": "playback"
    },
    {
      "ms": 390.1000003814697,
      "type": "request-start",
      "request": 5,
      "text": "And I can get really grumpy!",
      "emotion": "angry",
