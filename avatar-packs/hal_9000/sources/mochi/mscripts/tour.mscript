[Header start]
! HAL explains himself. Slowly, because that is the only speed he has.
! The glass and metal are realistic source artwork; the red optics are
! a separate rig with colour, level, spread, pulse and voice response.
[Header end]

[Resources start]
K[1]: 'characters/HAL 9000/hal.py'
[Resources end]

[Keyframes start]
P[1]: STATE[idle]     SIZE[1.00] GLOW[1.00] LEVEL[1.00] PULSE[0.16] RATE[1.1] DIM[1.0] COLOR[#FF1A08]
P[2]: STATE[idle]     SIZE[1.90] GLOW[1.70] LEVEL[1.60] PULSE[0.30] RATE[2.0] DIM[1.0] COLOR[#FF3018]
P[3]: STATE[idle]     SIZE[0.45] GLOW[0.60] LEVEL[0.35] PULSE[0.06] RATE[0.4] DIM[1.0] COLOR[#C81400]
P[4]: STATE[idle]     SIZE[1.00] GLOW[1.00] LEVEL[1.00] PULSE[0.16] RATE[1.1] DIM[1.0] COLOR[#FF1A08]
P[5]: STATE[dying]    SIZE[0.55] GLOW[0.40] LEVEL[0.25] PULSE[0.25] RATE[0.5] DIM[0.15] COLOR[#B41000]
